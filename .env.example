# Copy this file to .env and fill in real values. Never commit .env (see CLAUDE.md rule 12).

# PostgreSQL connection string. This is a local-dev placeholder — replace with a real
# connection string for your environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_portal?schema=public"

# development | test | production
NODE_ENV="development"

# Public-facing site name shown until real branding is supplied (CLAUDE.md rule 1).
NEXT_PUBLIC_SITE_NAME="[PLACEHOLDER] Affiliated College Portal"
