# Copy this file to .env and fill in real values. Never commit .env (see CLAUDE.md rule 12).

# PostgreSQL connection string. This is a local-dev placeholder — replace with a real
# connection string for your environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_portal?schema=public"

# development | test | production
NODE_ENV="development"

# Public-facing site name shown until real branding is supplied (CLAUDE.md rule 1).
NEXT_PUBLIC_SITE_NAME="[PLACEHOLDER] Affiliated College Portal"

# Absolute production origin (no trailing slash) — used to build absolute URLs in
# sitemap.xml/robots.txt and Open Graph/canonical meta tags. Defaults to localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://www.example-college.edu.pk"

# AES-256-GCM key encrypting Grievance.submitterEmail/submitterPhone at rest (CLAUDE.md rule
# 6 — private grievance data must never be exposed, including as plaintext in a database dump).
# 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for the grievance submission form to work; never share/reuse this value, and
# rotating it makes previously-submitted grievances undecryptable.
GRIEVANCE_ENCRYPTION_KEY=""

# Optional. Overrides the shared password for the 8 [DEV SEED] per-role login test accounts
# (prisma/seed.ts) that let you sign in locally as any role in docs/permission-matrix.md.
# Never seeded when NODE_ENV=production, regardless of this value. Defaults to
# "DevSeed!Passw0rd1" if unset — not a real secret, just a clearly-marked dev fixture.
# DEV_LOGIN_PASSWORD="DevSeed!Passw0rd1"

# Real site administrator accounts (prisma/seed.ts "Real site administrators" section) — one
# per role in docs/permission-matrix.md, for the actual people who manage this college's site
# (content register item 22). Each is created/updated only if its password is set here; unset
# ones are skipped with a warning so `npm run db:seed` stays idempotent and safe to re-run.
# Never commit real values (CLAUDE.md rule 12); rotate immediately if a value here was ever
# shared outside this file.
# SEED_PASSWORD_SUPER_ADMIN=""
# SEED_PASSWORD_PRINCIPAL=""
# SEED_PASSWORD_ADMINISTRATOR=""
# SEED_PASSWORD_EDITOR=""
# SEED_PASSWORD_REVIEWER=""
# SEED_PASSWORD_ADMISSION_OFFICER=""
# SEED_PASSWORD_EXAMINATION_OFFICER=""
# SEED_PASSWORD_FACULTY_EDITOR=""

# S3-compatible object storage for uploaded files (site logo, principal photo, gallery
# photos, documents, grievance attachments — src/lib/security/object-storage.ts). REQUIRED
# in production: this app has no persistent/writable filesystem once deployed (e.g. Vercel),
# so without these, every upload would silently fail to persist. Left unset in local dev,
# which writes to storage/ on disk instead — no cloud account needed to develop locally.
# Works with any S3-compatible provider:
#  - AWS S3: set STORAGE_S3_REGION (e.g. "us-east-1"), leave STORAGE_S3_ENDPOINT unset.
#  - Cloudflare R2 / Backblaze B2 / DigitalOcean Spaces / MinIO: set STORAGE_S3_ENDPOINT to
#    that provider's S3 API endpoint; STORAGE_S3_REGION can usually stay "auto".
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
