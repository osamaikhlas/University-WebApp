# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/playwright-report/
/test-results/
/blob-report/

# prisma
prisma/dev.db
prisma/dev.db-journal

# grievance attachments — private submitter files, never committed (CLAUDE.md rule 6, 12)
/storage/

# source images/documents supplied for real content seeding (prisma/seed.ts reads from here) —
# a staging drop folder, not meant to be committed; the served copies live in /storage/uploads
/Images/
