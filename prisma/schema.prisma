// ---------------------------------------------------------------------------------------
// 14. Grievance system (private data — CLAUDE.md rule 6). Never exposed through any public
//     API route; access restricted to grievance.view permission holders, enforced at the
//     query layer, not just hidden in the UI.
// ---------------------------------------------------------------------------------------

model Grievance {
  id        String @id @default(cuid())
  collegeId String

  // Shown to the submitter on successful submission and used to reference the case in any
  // later correspondence — never sequential/guessable (see src/lib/grievance-reference.ts).
  referenceNumber String @unique

  submitterName   String
  // App layer must encrypt these at rest before persisting (CLAUDE.md rule 6); these columns
  // hold ciphertext, never plaintext contact info. Phone is the one still-optional contact
  // field (email is required so staff always have a way to respond).
  submitterEmail  String
  submitterPhone  String?
  // Hash (never the raw address) of the submitting IP, kept only for abuse-pattern review
  // (CLAUDE.md rule 6 extends to not hoarding unnecessary PII) — see src/lib/security/rate-limit.ts.
  submitterIpHash String?

  category    String
  subject     String
  description String

  status       GrievanceStatus @default(NEW)
  assignedToId String?
  resolvedAt   DateTime?
  closedAt     DateTime?

  isPlaceholder Boolean  @default(false)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  college     College               @relation(fields: [collegeId], references: [id])
  assignedTo  User?                 @relation("GrievanceAssignee", fields: [assignedToId], references: [id])
  notes       GrievanceNote[]
  responses   GrievanceResponse[]
  attachments GrievanceAttachment[]

  @@index([collegeId])
  @@index([status])
  @@map("grievances")
}

// Internal-only case notes — never shown to the submitter or the public. Not in the
// originally requested model list, but required for Grievance to be usable at all (a
// grievance officer needs somewhere to record case progress); kept minimal.
model GrievanceNote {
  id          String   @id @default(cuid())
  grievanceId String
  authorId    String?
  note        String
  createdAt   DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  author    User?     @relation("GrievanceNoteAuthor", fields: [authorId], references: [id])

  @@index([grievanceId])
  @@map("grievance_notes")
}

// A recorded reply to the submitter (what staff communicated back and when). This system has
// no outbound email/SMS integration, so a response is the authoritative record of what was
// said, not proof that a message was actually delivered — see docs/architecture.md for the
// known gap. Still never shown to the public (CLAUDE.md rule 6): the submitter only ever
// finds out about it directly, out of band, using the reference number they were given.
model GrievanceResponse {
  id            String   @id @default(cuid())
  grievanceId   String
  respondedById String
  message       String
  createdAt     DateTime @default(now())

  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  respondedBy User      @relation("GrievanceResponder", fields: [respondedById], references: [id])

  @@index([grievanceId])
  @@map("grievance_responses")
}

// Submitter-provided evidence (screenshots, scanned letters, etc.). A dedicated model rather
// than the generic Document/Media tables (prisma/schema.prisma §15) because those require a
// real `uploadedById` User FK — a public grievance submitter is not a User. Files are stored
// outside `public/` and served only through an authenticated, permission-checked admin route
// (src/app/api/admin/grievances/[id]/attachments/[attachmentId]/route.ts) — never a public
// URL (CLAUDE.md rule 6).
model GrievanceAttachment {
  id          String   @id @default(cuid())
  grievanceId String
  fileName    String
  storedPath  String
  mimeType    String?
  sizeBytes   Int
  uploadedAt  DateTime @default(now())

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)

  @@index([grievanceId])
  @@map("grievance_attachments")
}

// Generic fixed-window rate-limit counter (src/lib/security/rate-limit.ts) — currently used
// to throttle anonymous public grievance submissions per source IP, but keyed generically
// (`"<scope>:<identifier>"`) so any other unauthenticated write path can reuse it without a
// new table.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rate_limit_entries")
}

// ---------------------------------------------------------------------------------------
// 15. Documents & media — generic attachment tables referenced by (entityType, entityId)
//     rather than a bespoke FK column on every module that needs an attachment or photo
//     (database-design.md §3: "shared by many modules").
// ---------------------------------------------------------------------------------------

model Document {
  id          String  @id @default(cuid())
  collegeId   String
  entityType  String
  entityId    String
  category    String?
  title       String
  description String?

  // The uploaded file. `storedPath` is an internal, non-public path within the upload
  // storage root (src/lib/security/upload-storage.ts) — the only way to read the bytes back
  // is through src/app/api/files/documents/[id]/route.ts, which enforces the public/
  // permission-checked visibility split (CLAUDE.md rule 5) rather than exposing storedPath
  // or any direct file URL. `fileName` is the original uploaded filename, used for the
  // download's Content-Disposition and shown in the UI; distinct from `title` (an editorial
  // label, not necessarily the file's actual name). Null only for a record with no file
  // uploaded yet — the publish transition requires one (see transitionDocument).
  storedPath String?
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  version    Int     @default(1)

  // Scheduling window — separate from `publishedAt` (set automatically when the workflow's
  // `publish` action runs). A document can be `status: PUBLISHED` yet still not currently
  // shown on the public site if `publishDate` is in the future or `expiryDate` has passed
  // (src/lib/content.ts's `getDocuments()`, mirroring Notice's existing publishDate/
  // expiryDate pattern) — the same window is also enforced by the file-serving route itself.
  publishDate DateTime?
  expiryDate  DateTime?

  uploadedById String
  uploadedAt   DateTime      @default(now())
  status       ContentStatus @default(DRAFT)

  // Set only by the workflow's `approve` transition (src/app/admin/documents/actions.ts),
  // never user-editable directly — "who approved this and when," distinct from `publishedBy`
  // (who actually flipped it live, a separate, later action).
  approvedById String?
  approvedAt   DateTime?

  isPlaceholder Boolean   @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  college    College @relation(fields: [collegeId], references: [id])
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id])
  approvedBy User?   @relation("DocumentApprover", fields: [approvedById], references: [id])

  @@index([collegeId])
  @@index([entityType, entityId])
  @@map("documents")
}

model Media {
  id         String  @id @default(cuid())
  collegeId  String
  entityType String?
  entityId   String?

  // The uploaded image. `storedPath` is internal-only (see Document's comment above) — read
  // back only through src/app/api/files/media/[id]/route.ts, which is public exactly when at
  // least one PUBLISHED GalleryItem currently references this asset (Media itself carries no
  // status of its own; visibility is governed entirely by the GalleryItem(s) wrapping it).
  storedPath String?
  mimeType   String?
  // Required (not optional) to satisfy accessibility (WCAG alt text) regardless of module.
  altText    String
  caption    String?
  category   String?
  // The date the image represents (e.g. an event date) — distinct from `uploadedAt`, the
  // system upload timestamp, which never changes on replacement.
  mediaDate  DateTime?
  mediaType  MediaType @default(IMAGE)

  uploadedById  String
  uploadedAt    DateTime @default(now())
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  college      College       @relation(fields: [collegeId], references: [id])
  uploadedBy   User          @relation("MediaUploader", fields: [uploadedById], references: [id])
  galleryItems GalleryItem[]

  @@index([collegeId])
  @@index([entityType, entityId])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------------------
// 16. Compliance model (docs/compliance-matrix.md, database-design.md §9)
//
// Divergence from database-design.md: the requested model list has no ComplianceItem —
// instead ComplianceRequirement carries a denormalized `status` (queried constantly for the
// dashboard). NOT_STARTED/IN_PROGRESS move automatically as the system recomputes each
// requirement's completeness against real content (see src/lib/compliance.ts) — that is
// bookkeeping, not an approval. READY_FOR_REVIEW/VERIFIED/NEEDS_UPDATE/NOT_APPLICABLE only
// ever change through an explicit human action recorded as a ComplianceVerification row
// (CLAUDE.md rule 7: a requirement must never become VERIFIED automatically). Evidence
// collection is tracked separately in ComplianceEvidence so a requirement can accumulate
// evidence across multiple content records over time without conflating "evidence exists"
// with "a human verified it".
//
// Status lifecycle (src/lib/compliance-workflow.ts):
//   NOT_STARTED <-> IN_PROGRESS   (automatic, from completeness/evidence)
//   IN_PROGRESS --submit_for_review--> READY_FOR_REVIEW
//   READY_FOR_REVIEW --verify--> VERIFIED
//   READY_FOR_REVIEW --request_update--> NEEDS_UPDATE   (reason mandatory)
//   VERIFIED --request_update--> NEEDS_UPDATE            (reason mandatory; re-flags a
//                                                          previously-verified item)
//   NEEDS_UPDATE --submit_for_review--> READY_FOR_REVIEW (after the owner fixes it)
//   NOT_STARTED/IN_PROGRESS --mark_not_applicable--> NOT_APPLICABLE   (reason mandatory)
//   NOT_APPLICABLE --reopen--> NOT_STARTED
// ---------------------------------------------------------------------------------------

model ComplianceRequirement {
  id                String             @id @default(cuid())
  collegeId         String
  // 1-20 per the circular's content items, or a governance-item code.
  itemNumber        Int
  title             String
  description       String
  circularReference String
  category          ComplianceCategory
  // Denormalized current status — see the lifecycle comment above. Only NOT_STARTED and
  // IN_PROGRESS are ever set automatically; every other value requires an explicit action
  // that also writes a ComplianceVerification row (CLAUDE.md rule 7).
  status            ComplianceStatus   @default(NOT_STARTED)
  ownerId           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  college       College                  @relation(fields: [collegeId], references: [id])
  owner         User?                    @relation("ComplianceOwner", fields: [ownerId], references: [id])
  evidence      ComplianceEvidence[]
  verifications ComplianceVerification[]

  @@unique([collegeId, itemNumber])
  @@index([collegeId])
  @@index([status])
  @@map("compliance_requirements")
}

// Points at whatever record(s) satisfy a requirement (a ContentItem-equivalent row, a
// Faculty record, a Program record, etc.) via a generic (entityType, entityId) pair, mirroring
// the Document/Media attachment pattern above.
model ComplianceEvidence {
  id            String   @id @default(cuid())
  requirementId String
  entityType    String
  entityId      String
  note          String?
  addedById     String
  createdAt     DateTime @default(now())

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  addedBy     User                  @relation("ComplianceEvidenceAdder", fields: [addedById], references: [id])

  @@index([requirementId])
  @@index([entityType, entityId])
  @@map("compliance_evidence")
}

// Append-only record of each human verification decision (reviewer notes live here too, on
// both decisions — not just rejections) — this is the "verification history" the Compliance
// Dashboard renders per requirement. The requirement's current `status` is set from the most
// recent row here — kept as its own table (rather than fields on ComplianceRequirement) so a
// full history of verify/needs-update cycles survives, per CLAUDE.md rule 8 (audit history).
model ComplianceVerification {
  id            String               @id @default(cuid())
  requirementId String
  decision      VerificationDecision
  verifiedById  String
  verifiedAt    DateTime             @default(now())
  // Reviewer notes. Mandatory for a NEEDS_UPDATE decision (the rejection reason); optional
  // free-text commentary for a VERIFIED decision.
  note          String?
  createdAt     DateTime             @default(now())

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  verifiedBy  User                  @relation("ComplianceVerifier", fields: [verifiedById], references: [id])

  @@index([requirementId])
  @@index([verifiedAt])
  @@map("compliance_verifications")
}

// The circular's explicit "compliance report + live website URL submitted to the Office of
// the Inspector of Colleges" requirement (docs/requirements.md §3, docs/compliance-matrix.md
// §2), made a real persisted artifact rather than a point-in-time export. `snapshot` freezes
// each requirement's itemNumber/title/status/completeness/last-verification at the moment of
// generation, so a later status change never rewrites what was actually submitted — this is
// deliberately NOT queried live from ComplianceRequirement/ComplianceVerification at read
// time, since the whole point is a durable record of what the college attested to on a given
// date. Generating a report never requires every requirement to be VERIFIED first (a college
// can report partial progress); only `submittedAt`/`submittedById` being set means it was
// actually sent to the Inspector of Colleges, and that's a one-way action (never re-set once
// present) — see `recordComplianceReportSubmission` in
// src/app/admin/compliance/report-actions.ts.
model ComplianceReportExport {
  id            String    @id @default(cuid())
  collegeId     String
  generatedAt   DateTime  @default(now())
  generatedById String
  snapshot      Json
  websiteUrl    String
  submittedAt   DateTime?
  submittedById String?

  college     College @relation(fields: [collegeId], references: [id])
  generatedBy User    @relation("ComplianceReportGenerator", fields: [generatedById], references: [id])
  submittedBy User?   @relation("ComplianceReportSubmitter", fields: [submittedById], references: [id])

  @@index([collegeId])
  @@index([generatedAt])
  @@map("compliance_report_exports")
}

// ---------------------------------------------------------------------------------------
// 17. Audit logging & notifications (database-design.md §6, §7)
// ---------------------------------------------------------------------------------------

// Append-only — no update/delete path is exposed for this table (CLAUDE.md rule 8).
// Append-only by design (CLAUDE.md rule 8, and the explicit "audit records should not be
// editable" requirement): no Server Action anywhere calls `.update()`/`.delete()` on this
// model — src/lib/audit.ts's `logAudit()` is the single application-layer write path, and
// the admin viewer (/admin/audit-logs) is read-only. Enforced beyond the application layer
// too, in the database itself: migration 20260916000000_audit_log_hardening adds Postgres
// triggers that reject any UPDATE/DELETE on this table outright, so the guarantee holds even
// against a future write path someone adds without reading this comment.
model AuditLog {
  id             String      @id @default(cuid())
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String
  beforeSnapshot Json?
  afterSnapshot  Json?
  // Free-form contextual detail beyond before/after field values — e.g. a login's user
  // agent, or which specific role a permission change added/removed. Distinct from
  // `comment` (a human-written reason/note) and from `ipAddress` (kept as its own column
  // since it existed first and is queried on its own).
  metadata       Json?
  comment        String?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Configurable review period for content freshness tracking (src/lib/admin/review-settings.ts,
// src/lib/content-review.ts) — one row per module key that has an explicit admin-set override;
// a module with no row here uses DEFAULT_REVIEW_PERIOD_DAYS. Not scoped to a College: review
// cadence is a system-wide admin policy, like Role/Permission, not per-tenant content. Changing
// a period here retroactively affects every record's computed "next review due" date, since
// that date is always derived live from (lastReviewedAt ?? publishedAt ?? createdAt) + this
// period rather than stored — see computeReviewFreshness().
model ReviewPeriodSetting {
  id         String   @id @default(cuid())
  moduleKey  String   @unique
  periodDays Int
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  @@map("review_period_settings")
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  type              String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
