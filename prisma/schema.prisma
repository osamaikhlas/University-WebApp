// Prisma schema — Phase 2 (database).
//
// Implements the models requested for Phase 2, using docs/database-design.md as the
// reference data model. Where the requested model list diverges from
// docs/database-design.md, the divergence is called out inline (e.g. ComplianceItem is
// split into ComplianceEvidence + ComplianceVerification here; Document/Media are generic
// attachment tables referenced by (entityType, entityId) rather than one bespoke FK column
// per module, per database-design.md §3's note that Document is "shared by many modules").
//
// No college-specific data belongs in this schema or its seed data — see CLAUDE.md rule 1.
// Content tables carry `isPlaceholder` so seed/dev data can never be mistaken for verified
// content (CLAUDE.md rule 14).
//
// Audit-stamp convention: `createdBy` / `updatedBy` / `publishedBy` are plain user-id
// strings, not enforced foreign keys. Adding a real FK relation for these on every one of
// ~30 content tables would force ~90 named back-relations onto User for no functional gain
// — the authoritative, queryable history of *who did what* is AuditLog, not these stamps.
// Fields that represent one significant, singular action instead get a real relation
// (Grievance.assignedTo, Document/Media.uploadedBy, ComplianceEvidence.addedBy,
// ComplianceVerification.verifiedBy, ComplianceRequirement.owner, AuditLog.actor,
// Notification.user) because those are actively queried ("show me everything assigned to
// this officer") rather than just stamped for reference.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (for the CLI) and is passed to the
// @prisma/adapter-pg driver adapter at runtime (for PrismaClient) — see src/lib/prisma.ts.
// Prisma 7 no longer supports `url` directly in this block.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------

enum CollegeType {
  GOVT_DEGREE
  PRIVATE_DEGREE
  LAW
  EDUCATION
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Shared content approval workflow (database-design.md §2) used by every structured
// content table below — see src/lib/content-workflow.ts for the full state machine:
//   DRAFT -> SUBMITTED -> UNDER_REVIEW -> APPROVED -> PUBLISHED
//   PUBLISHED -> UPDATE_REQUIRED -> DRAFT
// Only PUBLISHED content is ever shown on the public site (CLAUDE.md rule 4); reaching
// PUBLISHED always means the record passed through APPROVED first.
// ARCHIVED is reachable from any non-archived status (src/lib/content-workflow.ts's `archive`
// action) and is a deliberate, permanent-until-restored retirement — distinct from
// UPDATE_REQUIRED (still live, just flagged as needing an edit) and from DRAFT (never
// published yet). `unarchive` restores an archived record back to DRAFT for rework.
enum ContentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  UPDATE_REQUIRED
  ARCHIVED
}

// Case-management lifecycle for the grievance mechanism (CLAUDE.md rule 6, circular item 19)
// — see src/lib/grievance-workflow.ts for the full state machine. Deliberately not the
// generic ContentStatus draft/publish lifecycle: a grievance must never be "published," only
// ever worked by authorized staff.
enum GrievanceStatus {
  NEW
  ASSIGNED
  UNDER_REVIEW
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

enum InfrastructureCategory {
  CLASSROOM
  LAB
  LIBRARY
  COMPUTER_LAB
  MOOT_COURT
  OFFICE
  SPORTS
  OTHER
}

enum ContactType {
  PHONE
  EMAIL
  OTHER
}

enum ProgramLevel {
  UNDERGRADUATE
  GRADUATE
  DIPLOMA
  CERTIFICATE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ComplianceCategory {
  CONTENT
  GOVERNANCE
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_REVIEW
  VERIFIED
  NEEDS_UPDATE
  NOT_APPLICABLE
}

enum VerificationDecision {
  VERIFIED
  NEEDS_UPDATE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  START_REVIEW
  PUBLISH
  APPROVE
  REJECT
  REQUEST_UPDATE
  RETURN_TO_DRAFT
  COMPLIANCE_SUBMIT_FOR_REVIEW
  COMPLIANCE_VERIFY
  COMPLIANCE_REQUEST_UPDATE
  COMPLIANCE_MARK_NOT_APPLICABLE
  COMPLIANCE_REOPEN
  COMPLIANCE_EVIDENCE_ADDED
  COMPLIANCE_REPORT_GENERATED
  COMPLIANCE_REPORT_SUBMITTED
  GRIEVANCE_ASSIGN
  GRIEVANCE_STATUS_CHANGE
  GRIEVANCE_NOTE_ADDED
  GRIEVANCE_RESPONSE_SENT
  ARCHIVE
  UNARCHIVE
  UNPUBLISH
  FILE_REPLACED
  LOGIN
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGE
  MARK_REVIEWED
  OTHER
}

// ---------------------------------------------------------------------------------------
// 1. Tenancy & identity (docs/database-design.md §1)
// ---------------------------------------------------------------------------------------

model College {
  id            String      @id @default(cuid())
  name          String
  type          CollegeType
  // Marks seed/dev data so it can never be mistaken for a verified real college record
  // (CLAUDE.md rule 14).
  isPlaceholder Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  users     User[]
  userRoles UserRole[]

  profile                 CollegeProfile?
  departments             Department[]
  programs                Program[]
  courses                 Course[]
  faculty                 Faculty[]
  staff                   Staff[]
  infrastructure          Infrastructure[]
  notices                 Notice[]
  events                  Event[]
  seminars                Seminar[]
  workshops               Workshop[]
  academicCalendarEntries AcademicCalendar[]
  timetables              Timetable[]
  admissions              Admission[]
  feeStructures           FeeStructure[]
  enrollmentStatistics    EnrollmentStatistic[]
  examinations            Examination[]
  results                 Result[]
  contacts                Contact[]
  locations               Location[]
  affiliations            Affiliation[]
  activities              Activity[]
  clubs                   Club[]
  galleryAlbums           GalleryAlbum[]
  galleryItems            GalleryItem[]
  scholarships            Scholarship[]
  studentSupports         StudentSupport[]
  policies                Policy[]
  regulations             Regulation[]
  grievances              Grievance[]
  documents               Document[]
  media                   Media[]
  complianceRequirements  ComplianceRequirement[]
  complianceReportExports ComplianceReportExport[]

  @@map("colleges")
}

model User {
  id                  String     @id @default(cuid())
  collegeId           String
  name                String
  email               String     @unique
  passwordHash        String
  mfaEnabled          Boolean    @default(false)
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?
  // Login lockout (docs/architecture.md §3: "Account lockout/backoff on repeated failed
  // logins"). Reset to 0 on any successful login. Never exposed to the client beyond a
  // generic "account temporarily locked" message — never reveals the attempt count.
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  college  College    @relation(fields: [collegeId], references: [id])
  roles    UserRole[]
  sessions Session[]  @relation("UserSessions")

  assignedGrievances          Grievance[]              @relation("GrievanceAssignee")
  grievanceNotes              GrievanceNote[]          @relation("GrievanceNoteAuthor")
  grievanceResponses          GrievanceResponse[]      @relation("GrievanceResponder")
  uploadedDocuments           Document[]               @relation("DocumentUploader")
  approvedDocuments           Document[]               @relation("DocumentApprover")
  uploadedMedia               Media[]                  @relation("MediaUploader")
  ownedComplianceRequirements ComplianceRequirement[]  @relation("ComplianceOwner")
  addedComplianceEvidence     ComplianceEvidence[]     @relation("ComplianceEvidenceAdder")
  compliancesVerified         ComplianceVerification[] @relation("ComplianceVerifier")
  generatedComplianceReports  ComplianceReportExport[] @relation("ComplianceReportGenerator")
  submittedComplianceReports  ComplianceReportExport[] @relation("ComplianceReportSubmitter")
  auditLogEntries             AuditLog[]               @relation("AuditActor")
  notifications               Notification[]           @relation("NotificationRecipient")

  @@index([collegeId])
  @@map("users")
}

// Server-side session store (not JWT): the cookie only carries a high-entropy random
// token, never a role/permission claim — every request re-checks role/permission data
// straight from the database (CLAUDE.md rule 5, "never trust only client-side checks").
// Only a hash of the token is stored, mirroring how passwordHash never stores the raw
// password, so a leaked database dump cannot be replayed as a live cookie.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Baseline role set is generic system taxonomy (docs/database-design.md §1), not
// institutional data — real assignment of people to roles is a later, college-specific step.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Scoped per college (not just per user) so a user could hold different roles at different
// colleges if the system is later operated as a multi-college template.
model UserRole {
  userId    String
  roleId    String
  collegeId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, collegeId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------------------
// 2. College profile (circular item 1: About / College Profile / History / Vision & Mission
//    / Principal's Message) — one aggregate row per college rather than a generic
//    ContentItem table, since these sections are singular per college, not a list.
// ---------------------------------------------------------------------------------------

model CollegeProfile {
  id               String        @id @default(cuid())
  collegeId        String        @unique
  overview         String?
  missionStatement String?
  visionStatement  String?
  history          String?
  principalName    String?
  principalMessage String?
  establishedYear  Int?
  status           ContentStatus @default(DRAFT)
  isPlaceholder    Boolean       @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([status])
  @@map("college_profiles")
}

// ---------------------------------------------------------------------------------------
// 3. Academic structure (circular items 3, 4, 6, 13)
// ---------------------------------------------------------------------------------------

model Department {
  id            String        @id @default(cuid())
  collegeId     String
  name          String
  description   String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college   College    @relation(fields: [collegeId], references: [id])
  programs  Program[]
  faculty   Faculty[]
  seminars  Seminar[]
  workshops Workshop[]

  @@index([collegeId])
  @@map("departments")
}

model Program {
  id            String        @id @default(cuid())
  collegeId     String
  departmentId  String
  name          String
  level         ProgramLevel
  durationYears Int
  description   String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college              College               @relation(fields: [collegeId], references: [id])
  department           Department            @relation(fields: [departmentId], references: [id])
  courses              Course[]
  admissions           Admission[]
  feeStructures        FeeStructure[]
  enrollmentStatistics EnrollmentStatistic[]
  timetables           Timetable[]
  examinations         Examination[]
  results              Result[]
  affiliations         Affiliation[]

  @@index([collegeId])
  @@index([departmentId])
  @@map("programs")
}

model Course {
  id            String        @id @default(cuid())
  collegeId     String
  programId     String
  code          String
  title         String
  creditHours   Int?
  semester      Int?
  description   String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, code])
  @@index([collegeId])
  @@map("courses")
}

// Affiliation is not embedded as a single FK on Program because a program's affiliation is
// renewed/re-approved over time — a program has a history of Affiliation records, not one.
model Affiliation {
  id                String        @id @default(cuid())
  collegeId         String
  programId         String?
  universityName    String
  affiliationNumber String?
  regulatoryBody    String?
  validFrom         DateTime?
  validTo           DateTime?
  status            ContentStatus @default(DRAFT)
  isPlaceholder     Boolean       @default(false)
  publishedAt       DateTime?
  publishedBy       String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  college College  @relation(fields: [collegeId], references: [id])
  program Program? @relation(fields: [programId], references: [id])

  @@index([collegeId])
  @@index([programId])
  @@map("affiliations")
}

// ---------------------------------------------------------------------------------------
// 4. People (circular items 4, 5)
// ---------------------------------------------------------------------------------------

model Faculty {
  id               String        @id @default(cuid())
  collegeId        String
  departmentId     String
  name             String
  designation      String
  qualifications   String?
  subjectsTaught   String[]
  email            String?
  phone            String?
  status           ContentStatus @default(DRAFT)
  isPlaceholder    Boolean       @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  createdBy        String?
  updatedBy        String?
  // Content review/freshness tracking (src/lib/content-review.ts) — distinct from the
  // publish workflow above: a record can be PUBLISHED and still be "due for review" if
  // nobody has confirmed it's still accurate within the configurable review period. Plain
  // id, not a relation, per this file's top-of-file audit-stamp convention.
  lastReviewedAt   DateTime?
  lastReviewedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  college      College    @relation(fields: [collegeId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  advisedClubs Club[]

  @@index([collegeId])
  @@index([departmentId])
  @@map("faculty")
}

model Staff {
  id            String        @id @default(cuid())
  collegeId     String
  name          String
  designation   String
  department    String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@map("staff")
}

model Club {
  id               String        @id @default(cuid())
  collegeId        String
  name             String
  description      String?
  facultyAdvisorId String?
  status           ContentStatus @default(DRAFT)
  isPlaceholder    Boolean       @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  college        College  @relation(fields: [collegeId], references: [id])
  facultyAdvisor Faculty? @relation(fields: [facultyAdvisorId], references: [id])

  @@index([collegeId])
  @@map("clubs")
}

// ---------------------------------------------------------------------------------------
// 5. Infrastructure (circular item 3)
// ---------------------------------------------------------------------------------------

model Infrastructure {
  id            String                 @id @default(cuid())
  collegeId     String
  category      InfrastructureCategory
  name          String
  description   String?
  status        ContentStatus          @default(DRAFT)
  isPlaceholder Boolean                @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@index([category])
  @@map("infrastructure_items")
}

// ---------------------------------------------------------------------------------------
// 6. Communications (circular items 2, 10, 14, 15)
// ---------------------------------------------------------------------------------------

model Notice {
  id               String        @id @default(cuid())
  collegeId        String
  title            String
  body             String
  category         String?
  publishDate      DateTime?
  expiryDate       DateTime?
  status           ContentStatus @default(DRAFT)
  isPlaceholder    Boolean       @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  createdBy        String?
  updatedBy        String?
  lastReviewedAt   DateTime?
  lastReviewedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  college      College       @relation(fields: [collegeId], references: [id])
  examinations Examination[]

  @@index([collegeId])
  @@index([publishDate])
  @@map("notices")
}

model Event {
  id            String        @id @default(cuid())
  collegeId     String
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@index([startDate])
  @@map("events")
}

model Seminar {
  id            String        @id @default(cuid())
  collegeId     String
  departmentId  String?
  title         String
  description   String?
  speaker       String?
  startDate     DateTime
  endDate       DateTime?
  venue         String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college    College     @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([collegeId])
  @@index([startDate])
  @@map("seminars")
}

model Workshop {
  id            String        @id @default(cuid())
  collegeId     String
  departmentId  String?
  title         String
  description   String?
  facilitator   String?
  startDate     DateTime
  endDate       DateTime?
  venue         String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college    College     @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([collegeId])
  @@index([startDate])
  @@map("workshops")
}

model Activity {
  id            String        @id @default(cuid())
  collegeId     String
  title         String
  description   String?
  category      String?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@map("activities")
}

// ---------------------------------------------------------------------------------------
// 7. Calendar & scheduling (circular item 7)
// ---------------------------------------------------------------------------------------

model AcademicCalendar {
  id               String        @id @default(cuid())
  collegeId        String
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  category         String?
  academicYear     String?
  status           ContentStatus @default(DRAFT)
  isPlaceholder    Boolean       @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  createdBy        String?
  updatedBy        String?
  lastReviewedAt   DateTime?
  lastReviewedById String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@index([academicYear])
  @@map("academic_calendar_entries")
}

model Timetable {
  id                 String        @id @default(cuid())
  collegeId          String
  programId          String
  classGroup         String
  effectiveFrom      DateTime
  structuredSchedule Json?
  status             ContentStatus @default(DRAFT)
  isPlaceholder      Boolean       @default(false)
  publishedAt        DateTime?
  publishedBy        String?
  createdBy          String?
  updatedBy          String?
  lastReviewedAt     DateTime?
  lastReviewedById   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@index([collegeId])
  @@index([programId])
  @@map("timetables")
}

// ---------------------------------------------------------------------------------------
// 8. Admissions & enrollment (circular items 8, 9)
// ---------------------------------------------------------------------------------------

model Admission {
  id                   String        @id @default(cuid())
  collegeId            String
  programId            String
  academicYear         String
  eligibilityCriteria  String?
  applicationStartDate DateTime?
  applicationEndDate   DateTime?
  status               ContentStatus @default(DRAFT)
  isPlaceholder        Boolean       @default(false)
  publishedAt          DateTime?
  publishedBy          String?
  createdBy            String?
  updatedBy            String?
  lastReviewedAt       DateTime?
  lastReviewedById     String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  college       College        @relation(fields: [collegeId], references: [id])
  program       Program        @relation(fields: [programId], references: [id])
  feeStructures FeeStructure[]

  @@index([collegeId])
  @@index([programId])
  @@map("admissions")
}

model FeeStructure {
  id            String        @id @default(cuid())
  collegeId     String
  programId     String
  admissionId   String?
  academicYear  String
  feeType       String
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("PKR")
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college   College    @relation(fields: [collegeId], references: [id])
  program   Program    @relation(fields: [programId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])

  @@index([collegeId])
  @@index([programId])
  @@map("fee_structures")
}

model EnrollmentStatistic {
  id            String        @id @default(cuid())
  collegeId     String
  programId     String
  academicYear  String
  sessionType   String?
  totalEnrolled Int
  maleCount     Int?
  femaleCount   Int?
  status        ContentStatus @default(DRAFT)
  isPlaceholder Boolean       @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@index([collegeId])
  @@index([programId])
  @@map("enrollment_statistics")
}

// ---------------------------------------------------------------------------------------
// 9. Examinations & results (circular item 10)
// ---------------------------------------------------------------------------------------

model Examination {
  id                String        @id @default(cuid())
  collegeId         String
  programId         String
  examType          String
  academicYear      String?
  scheduleStartDate DateTime?
  scheduleEndDate   DateTime?
  noticeId          String?
  status            ContentStatus @default(DRAFT)
  isPlaceholder     Boolean       @default(false)
  publishedAt       DateTime?
  publishedBy       String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  college College  @relation(fields: [collegeId], references: [id])
  program Program  @relation(fields: [programId], references: [id])
  notice  Notice?  @relation(fields: [noticeId], references: [id])
  results Result[]

  @@index([collegeId])
  @@index([programId])
